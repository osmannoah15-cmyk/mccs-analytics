# ---------------------------------------------------------------
# MCCS Revenue Intelligence - environment variables
# Copy to .env for local development. In Render, set these in the
# service dashboard under Environment. Never commit a real .env.
# ---------------------------------------------------------------

# Postgres. Render injects this automatically when you link a database.
DATABASE_URL=postgresql://user:password@localhost:5432/mccs_ri

# Session signing secret. Generate with:  openssl rand -hex 32
SESSION_SECRET=replace_me_with_a_long_random_string
SESSION_HOURS=8

# First admin account, created automatically on first boot when the
# users table is empty. Use a password of at least 10 characters.
ADMIN_EMAIL=noah.osman@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Noah Osman

# ---- Ask Sage ----
# The API key stays server side and is never sent to the browser.
ASKSAGE_API_KEY=
ASKSAGE_EMAIL=
ASKSAGE_MODEL=gpt-4.1-mini
ASKSAGE_TEMPERATURE=0.2
ASKSAGE_TIMEOUT_MS=45000

# Only change these if your organization uses a different Ask Sage
# instance (for example a GovCloud or IL5 deployment).
ASKSAGE_USER_BASE=https://api.asksage.ai/user
ASKSAGE_SERVER_BASE=https://api.asksage.ai/server

# Per-user AI calls allowed each minute.
AI_RATE_LIMIT_PER_MIN=20

# Data loading.
# An empty database always loads dataset.json automatically, so no variable is
# needed for a normal deployment. Set AUTO_SEED=false only if you want to
# manage loading yourself from the Admin tab.
# AUTO_SEED=false
#
# Set RESET_DATA=true to wipe and reload on the next boot, then REMOVE it.
# Left in place, it wipes the database on every restart.
# RESET_DATA=true

NODE_ENV=development
PORT=3000
